generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model ArtistProfile {
  id              String   @id @default(cuid())
  name            String
  bio             String?
  phone           String?
  email           String?
  location        String?
  avatar          String?
  website         String?
  instagram       String?
  facebook        String?
  x               String?
  behance         String?
  dribbble        String?
  artStyle        String?
  specialty       String?
  availableForWork Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Artwork {
  id          String   @id @default(cuid())
  title       String
  description String
  year        Int
  category    String
  image       String
  colors      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([category])
  @@index([createdAt])
}